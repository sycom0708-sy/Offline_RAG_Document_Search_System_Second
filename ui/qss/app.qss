/* DESIGN §10 디자인 토큰을 그대로 옮긴다.
   Qt Style Sheets는 CSS 변수를 지원하지 않아 값을 그대로 반복 기입한다.

   페이지 배경 #F7F8F9 · 패널/카드 #FFFFFF · 테두리 #E5E7EB
   본문 텍스트 #1F2937 · 보조 텍스트 #9CA3AF · 강조 #2563EB
   검색어 하이라이트 #FDE68A(ui/highlight.py에서 인라인으로 직접 적용)
*/

QMainWindow, #CentralWidget {
    background: #F7F8F9;
}

#MainArea {
    background: #F7F8F9;
}

/* ---------- 검색 결과 헤더 (Phase 7.7) ----------
   검색 결과 모드에서만 보인다 — 챗봇 모드는 헤더 없이 대화만 흐른다
   (DESIGN §5.8). */
#ResultHeader {
    background: #FFFFFF;
    border-bottom: 1px solid #E5E7EB;
}

#ResultHeaderTitle {
    color: #1F2937;
    font-size: 14px;
    font-weight: 700;
}

#ResultHeaderClose {
    border: none;
    background: transparent;
    color: #9CA3AF;
    font-size: 16px;
    padding: 2px 6px;
}

#ResultHeaderClose:hover {
    color: #1F2937;
}

/* ---------- 사이드바 (§4) ---------- */

#Sidebar {
    background: #FFFFFF;
    border-right: 1px solid #E5E7EB;
}

#SidebarSectionLabel {
    color: #9CA3AF;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.02em;
}

/* 문서 형식 체크박스(§4.1)·토글 스위치(§4.2)는 QSS `::indicator`로는
   참조 이미지의 굵은 체크마크·슬라이딩 손잡이를 표현할 수 없어
   커스텀 페인팅(StyledCheckbox, _SwitchIndicator)으로 직접 그린다. */

#ToggleSwitchLabel {
    color: #1F2937;
    font-size: 14px;
}

#ToggleSwitchLabel:disabled {
    color: #9CA3AF;
}

/* PC 성능 콤보 (§4.3) */
#PerformanceCombo {
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 14px;
    color: #1F2937;
    background: #FFFFFF;
}

/* 사이드바 하단 "최근 검색" (Phase 7.7) */
#RecentSearchItem {
    border: none;
    background: transparent;
    color: #9CA3AF;
    font-size: 12px;
    padding: 5px 0;
    text-align: left;
}

#RecentSearchItem:hover {
    color: #2563EB;
}

/* 사이드바 하단 "모델 관리"·"폴더 관리" (Phase 7.7 — 각각 PerformanceCombo·
   StatusBar에 흩어져 있던 것을 옮겼다) */
#SidebarFooterButton {
    background: #F7F8F9;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    color: #1F2937;
    font-size: 12px;
    padding: 8px 4px;
}

#SidebarFooterButton:hover {
    background: #E5E7EB;
}

/* ---------- 결과 리스트 / 카드 (§5) ---------- */

#ResultList {
    background: #F7F8F9;
    border: none;
}

#ResultListMessage {
    color: #9CA3AF;
    font-size: 14px;
    padding: 48px 24px;
}

#ResultCard {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
}

/* AI 요약 카드 (Phase 7) — 결과 카드와 구별되도록 파란 계열을 쓴다.
   DESIGN에 명세가 없어 새로 정한 것이다(§4.2에 토글만 있었다). */
#AiSummaryCard {
    background: #F5F8FF;
    border: 1px solid #C7D7FE;
    border-radius: 8px;
}

#AiSummaryCard[state="failed"] {
    background: #FEF6F6;
    border-color: #F5C2C2;
}

#AiSummaryTitle {
    color: #2563EB;
    font-size: 13px;
    font-weight: 700;
}

#AiSummaryBody {
    color: #1F2937;
    font-size: 14px;
}

/* 준비 중·생성 중은 아직 내용이 아니므로 흐리게 둔다. */
#AiSummaryCard[state="pending"] #AiSummaryBody,
#AiSummaryCard[state="empty"] #AiSummaryBody {
    color: #6B7280;
}

#AiSummaryCard[state="failed"] #AiSummaryBody {
    color: #B91C1C;
}

/* 4단계 안전장치 배지 — 답을 숨기지 않고 검토가 필요함만 표시한다. */
#AiSummaryReviewBadge {
    background: #FEF3C7;
    color: #92400E;
    border: 1px solid #FDE68A;
    border-radius: 4px;
    font-size: 12px;
    padding: 2px 8px;
}

#AiSummaryHint {
    color: #6B7280;
    font-size: 12px;
}

#ResultCard[relevance="low"] {
    border-color: #F1F2F4;
}

#ResultCardFileName {
    color: #1F2937;
    font-size: 14px;
    font-weight: 700;
}

#ResultCardSeparator, #ResultCardLocation {
    color: #9CA3AF;
    font-size: 12px;
}

#ResultCardRelevanceLabel {
    color: #9CA3AF;
    font-size: 12px;
}

#ResultCardFileNameMatchLabel {
    color: #9CA3AF;
    font-size: 12px;
}

#ResultCardBody {
    color: #1F2937;
    font-size: 14px;
}

#ResultCardOpenButton {
    border: none;
    background: transparent;
    color: #2563EB;
    font-size: 12px;
    padding: 2px 4px;
}

#ResultCardOpenButton:hover {
    text-decoration: underline;
}

#ResultCardCopyButton {
    border: none;
    background: transparent;
    color: #2563EB;
    font-size: 12px;
    padding: 2px 4px;
}

#ResultCardCopyButton:hover {
    text-decoration: underline;
}

/* ---------- AI 챗봇 패널 (Phase 7.6) ----------
   결과 카드·AI 요약 카드와 같은 토큰을 쓴다. 새 색을 만들지 않고
   #ChatAnswerBubble은 #AiSummaryCard보다 옅은 배경으로 "아직 AI가
   생성한 게 아니라 검색으로 찾은 원문"이라는 걸 구분한다. */
#ChatTranscript {
    background: #F7F8F9;
    border: none;
}

#ChatUserMessage {
    background: #2563EB;
    color: #FFFFFF;
    font-size: 14px;
    border-radius: 8px;
    border-bottom-right-radius: 2px;  /* 말풍선 꼬리 방향 — 컨셉 목업 참고 */
    padding: 8px 12px;
}

#ChatAnswerBubble {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    border-bottom-left-radius: 2px;
}

#ChatExcerptBody {
    color: #1F2937;
    font-size: 14px;
}

#ChatExcerptSource {
    color: #9CA3AF;
    font-size: 12px;
}

/* 검색 결과·챗봇 발췌 개수 상한(5개) + "더보기" 버튼 (2026-08-14, [제안] —
   DESIGN에 명세 없음). #ResultCardCopyButton과 같은 톤으로 맞춘다.
   챗봇도 검색과 같은 버튼을 쓴다(처음엔 텍스트 안내만이었다가, 사용자
   요청으로 검색과 동일한 "더보기" 버튼으로 통일했다). */
#ResultListMoreButton {
    border: none;
    background: transparent;
    color: #2563EB;
    font-size: 13px;
    padding: 6px;
}

#ResultListMoreButton:hover {
    text-decoration: underline;
}

/* ---------- 공용 입력창 (Phase 7.7) ----------
   검색 결과 모드·챗봇 모드가 함께 쓴다. 옛 #ChatInput/#ChatSendButton(챗봇
   전용 시절)과 #SearchInput(검색 전용 시절)을 이 규칙으로 통합했다. */
#InputBar {
    background: #FFFFFF;
    border-top: 1px solid #E5E7EB;
}

#InputBarField {
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    color: #1F2937;
    background: #FFFFFF;
}

#InputBarField:focus {
    border-color: #2563EB;
}

#InputBarSendButton {
    background: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 14px;
}

#InputBarSendButton:hover {
    background: #1D4ED8;
}

/* 표 카드 (§5.4) */
#TableCardGrid {
    border: 1px solid #E5E7EB;
    gridline-color: #E5E7EB;
    font-size: 13px;
    color: #1F2937;
    background: #FFFFFF;
}

#TableCardGrid QHeaderView::section {
    background: #F1F2F4;
    color: #1F2937;
    font-weight: 700;
    font-size: 12px;
    border: 1px solid #E5E7EB;
    padding: 4px 6px;
}

/* 이미지 카드 (§5.5) */
#ImageCardThumbnail {
    border: 1px solid #E5E7EB;
    border-radius: 4px;
    background: #F7F8F9;
}

#ImageCardNotice {
    color: #9CA3AF;
    font-size: 13px;
}

/* ---------- 상태바 (§6) ---------- */

#StatusBar {
    background: #FFFFFF;
    border-top: 1px solid #E5E7EB;
}

#StatusBarInfo {
    color: #9CA3AF;
    font-size: 12px;
}

#IndexingProgressFile {
    color: #9CA3AF;
    font-size: 12px;
}

#IndexingProgressTime {
    color: #9CA3AF;
    font-size: 12px;
}

#StatusBarWarning {
    /* DESIGN에 경고색 지정이 없어 자체 판단[제안] — amber 계열 */
    color: #B45309;
    font-size: 12px;
}

/* ---------- 모델 관리 팝업 ---------- */

#ModelManagerIntro, #ModelManagerPlaceholder {
    color: #9CA3AF;
    font-size: 12px;
}

#ModelRowName {
    color: #1F2937;
    font-size: 14px;
    font-weight: 700;
}

#ModelRowBadge[state="installed"] {
    color: #15803D;
    font-size: 11px;
    font-weight: 700;
}

#ModelRowBadge[state="pending"] {
    color: #52606D;
    font-size: 11px;
    font-weight: 700;
}

/* 파일은 있으나 크기·체크섬이 안 맞는다 (T7.9) */
#ModelRowBadge[state="invalid"] {
    color: #B91C1C;
    font-size: 11px;
    font-weight: 700;
}

#ModelRowNote {
    color: #9CA3AF;
    font-size: 11px;
}
