/* DESIGN §10 디자인 토큰을 그대로 옮긴다.
   Qt Style Sheets는 CSS 변수를 지원하지 않아 값을 그대로 반복 기입한다.

   본문 영역 배경 #F3F6FA(Phase 11 확정) · 패널/카드 #FFFFFF · 테두리 #E5E7EB
   사이드바 #1E293B(다크 네이비, Phase 11)
   본문 텍스트 #1F2937 · 보조 텍스트 #9CA3AF · 강조 #2563EB
   검색어 하이라이트 #FDE68A(ui/highlight.py에서 인라인으로 직접 적용)
*/

QMainWindow, #CentralWidget {
    background: #F3F6FA;
}

#MainArea {
    background: #F3F6FA;
}

/* ---------- 검색 결과 헤더 (Phase 7.7) ----------
   검색 결과 모드에서만 보인다 — 챗봇 모드는 헤더 없이 대화만 흐른다
   (DESIGN §5.8). */
#ResultHeader {
    background: #FFFFFF;
    border-bottom: 1px solid #E5E7EB;
}

#ResultHeaderTitle {
    color: #1F2937;
    font-size: 14px;
    font-weight: 700;
}

#ResultHeaderClose {
    border: none;
    background: transparent;
    color: #9CA3AF;
    font-size: 16px;
    padding: 2px 6px;
}

#ResultHeaderClose:hover {
    color: #1F2937;
}

/* ---------- 사이드바 (§4) ---------- */

/* Phase 11: 다크 네이비 네비게이션(DESIGN §14.2·§14.6). */
#Sidebar {
    background: #1E293B;
    border-right: none;
}

#SidebarTitle {
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 700;
}

#SidebarNavButton {
    border: none;
    background: transparent;
    color: #94A3B8;
    font-size: 14px;
    text-align: left;
    padding: 8px 10px;
    border-radius: 6px;
}

#SidebarNavButton:hover {
    background: #27364B;
    color: #FFFFFF;
}

#SidebarNavButton[active="true"] {
    background: #27364B;
    color: #FFFFFF;
    font-weight: 700;
}

#SidebarExpandButton {
    border: none;
    background: transparent;
    color: #94A3B8;
    font-size: 14px;
    padding: 8px 0;
    border-radius: 6px;
}

#SidebarExpandButton:hover {
    background: #27364B;
    color: #FFFFFF;
}

/* 확장 영역은 사이드바와 같은 다크 네이비다[사용자 확정, 2026-08-18].
   StyledCheckbox는 이 배경에 맞춰 다시 칠했고(체크 시 강조색 채움 + 흰 체크마크),
   토글 라벨은 아래에서 밝은 색으로 덮어쓴다. */
#SidebarExpansion {
    background: transparent;
}

/* 확장 영역 안의 토글 라벨만 밝게 — `folder_dialog`의 감시 토글은 밝은 배경에
   있으므로 전역 규칙을 바꾸면 안 된다. */
#SidebarExpansion #ToggleSwitchLabel {
    color: #E2E8F0;
}

#SidebarExpansion #ToggleSwitchLabel:disabled {
    color: #64748B;
}

#SidebarSectionLabel {
    color: #9CA3AF;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.02em;
}

/* ---------- 페이지 카드 (Phase 11, DESIGN §14.4·§14.5) ---------- */

#PageCard {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 10px;
}

#PageEyebrow {
    color: #9CA3AF;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
}

#PageCardTitle {
    color: #1F2937;
    font-size: 18px;
    font-weight: 700;
}

#PageCardBody {
    color: #6B7280;
    font-size: 13px;
}

#PrimaryButton {
    background: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 700;
}

#PrimaryButton:hover {
    background: #1D4ED8;
}

#PrimaryButton:disabled {
    background: #C7D2E4;
    color: #F3F6FA;
}

/* ---------- 문서 관리 페이지 (Phase 11-B, DESIGN §14.4) ---------- */

/* 카드 5장이 낮은 창에서 넘치므로 스크롤로 받는다. 스크롤 영역·내용 위젯이
   자기 배경을 칠하면 본문 배경(#F3F6FA) 위에 흰 판이 덧대진다 — 투명하게
   둬서 본문 배경이 그대로 비치게 한다. */
#PageScroll, #PageScrollContent {
    background: transparent;
    border: none;
}

#PageCardHint {
    color: #9CA3AF;
    font-size: 12px;
}

#PageBadge {
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 700;
}

#PageBadge[tone="idle"] {
    background: #EEF2F7;
    color: #6B7280;
}

#PageBadge[tone="busy"] {
    background: #2563EB;
    color: #FFFFFF;
}

#PageBadge[tone="error"] {
    background: #FEE2E2;
    color: #B91C1C;
}

#StatCell {
    background: #F8FAFC;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
}

#StatCellValue {
    color: #1F2937;
    font-size: 20px;
    font-weight: 700;
}

#StatCellLabel {
    color: #9CA3AF;
    font-size: 12px;
}

#FailureRow {
    color: #B91C1C;
    font-size: 12px;
}

/* 진행 바는 지금까지 팝업 안에만 있어 플랫폼 기본 모양을 썼다. 흰 카드 위에
   올라오니 테두리 없는 막대로 보여서, 여기서 트랙을 명시한다. */
#IndexingProgressBar {
    background: #EEF2F7;
    border: none;
    border-radius: 4px;
    max-height: 8px;
}

#IndexingProgressBar::chunk {
    background: #2563EB;
    border-radius: 4px;
}

/* 문서 형식 체크박스(§4.1)·토글 스위치(§4.2)는 QSS `::indicator`로는
   참조 이미지의 굵은 체크마크·슬라이딩 손잡이를 표현할 수 없어
   커스텀 페인팅(StyledCheckbox, _SwitchIndicator)으로 직접 그린다. */

#ToggleSwitchLabel {
    color: #1F2937;
    font-size: 14px;
}

#ToggleSwitchLabel:disabled {
    color: #9CA3AF;
}

/* PC 성능 콤보 (§4.3) */
#PerformanceCombo {
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 14px;
    color: #1F2937;
    background: #FFFFFF;
}

/* 사이드바 하단 "최근 검색" (Phase 7.7) */
#RecentSearchItem {
    border: none;
    background: transparent;
    color: #9CA3AF;
    font-size: 12px;
    padding: 5px 0;
    text-align: left;
}

#RecentSearchItem:hover {
    color: #2563EB;
}

/* 사이드바 하단 "모델 관리"·"폴더 관리" (Phase 7.7 — 각각 PerformanceCombo·
   StatusBar에 흩어져 있던 것을 옮겼다) */
#SidebarFooterButton {
    background: #F7F8F9;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    color: #1F2937;
    font-size: 12px;
    padding: 8px 4px;
}

#SidebarFooterButton:hover {
    background: #E5E7EB;
}

/* 🔴 배경을 커스텀 색으로 지정하는 순간 Qt의 기본 "비활성화" 회색 처리가
   더는 자동으로 안 먹는다 — 이 규칙 없이는 비활성 버튼과 활성 버튼이
   똑같아 보여 무엇을 누를 수 있는지 구분이 안 된다(모델 관리 팝업에서
   실제로 이렇게 나온 것을 캡처로 확인). */
#SidebarFooterButton:disabled {
    background: #F7F8F9;
    color: #C7CDD6;
    border-color: #EEF1F4;
}

/* ---------- 결과 리스트 / 카드 (§5) ---------- */

#ResultList {
    background: #F7F8F9;
    border: none;
}

#ResultListMessage {
    color: #9CA3AF;
    font-size: 14px;
    padding: 48px 24px;
}

#ResultCard {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
}

/* AI 요약 카드 (Phase 7) — 결과 카드와 구별되도록 파란 계열을 쓴다.
   DESIGN에 명세가 없어 새로 정한 것이다(§4.2에 토글만 있었다). */
#AiSummaryCard {
    background: #F5F8FF;
    border: 1px solid #C7D7FE;
    border-radius: 8px;
}

#AiSummaryCard[state="failed"] {
    background: #FEF6F6;
    border-color: #F5C2C2;
}

#AiSummaryTitle {
    color: #2563EB;
    font-size: 13px;
    font-weight: 700;
}

#AiSummaryBody {
    color: #1F2937;
    font-size: 14px;
}

/* 준비 중·생성 중은 아직 내용이 아니므로 흐리게 둔다. */
#AiSummaryCard[state="pending"] #AiSummaryBody,
#AiSummaryCard[state="empty"] #AiSummaryBody {
    color: #6B7280;
}

#AiSummaryCard[state="failed"] #AiSummaryBody {
    color: #B91C1C;
}

/* 4단계 안전장치 배지 — 답을 숨기지 않고 검토가 필요함만 표시한다. */
#AiSummaryReviewBadge {
    background: #FEF3C7;
    color: #92400E;
    border: 1px solid #FDE68A;
    border-radius: 4px;
    font-size: 12px;
    padding: 2px 8px;
}

#AiSummaryHint {
    color: #6B7280;
    font-size: 12px;
}

#ResultCard[relevance="low"] {
    border-color: #F1F2F4;
}

#ResultCardFileName {
    color: #1F2937;
    font-size: 14px;
    font-weight: 700;
}

#ResultCardSeparator, #ResultCardLocation {
    color: #9CA3AF;
    font-size: 12px;
}

/* 이 청크가 속한 절의 제목 (T10.31) — 파일명·위치 줄 아래, 발췌 바로 위.
   본문(#ResultCardBody)보다 진하고 굵게 둬서 "제목"으로 읽히게 한다. */
#ResultCardHeading {
    color: #374151;
    font-size: 13px;
    font-weight: 700;
}

#ResultCardRelevanceLabel {
    color: #9CA3AF;
    font-size: 12px;
}

#ResultCardFileNameMatchLabel {
    color: #9CA3AF;
    font-size: 12px;
}

#ResultCardBody {
    color: #1F2937;
    font-size: 14px;
}

#ResultCardOpenButton {
    border: none;
    background: transparent;
    color: #2563EB;
    font-size: 12px;
    padding: 2px 4px;
}

#ResultCardOpenButton:hover {
    text-decoration: underline;
}

#ResultCardCopyButton {
    border: none;
    background: transparent;
    color: #2563EB;
    font-size: 12px;
    padding: 2px 4px;
}

#ResultCardCopyButton:hover {
    text-decoration: underline;
}

/* ---------- AI 챗봇 패널 (Phase 7.6) ----------
   결과 카드·AI 요약 카드와 같은 토큰을 쓴다. 새 색을 만들지 않고
   #ChatAnswerBubble은 #AiSummaryCard보다 옅은 배경으로 "아직 AI가
   생성한 게 아니라 검색으로 찾은 원문"이라는 걸 구분한다. */
#ChatTranscript {
    background: #F7F8F9;
    border: none;
}

#ChatUserMessage {
    background: #2563EB;
    color: #FFFFFF;
    font-size: 14px;
    border-radius: 8px;
    border-bottom-right-radius: 2px;  /* 말풍선 꼬리 방향 — 컨셉 목업 참고 */
    padding: 8px 12px;
}

#ChatAnswerBubble {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    border-bottom-left-radius: 2px;
}

#ChatExcerptBody {
    color: #1F2937;
    font-size: 14px;
}

#ChatExcerptSource {
    color: #9CA3AF;
    font-size: 12px;
}

/* 검색 결과·챗봇 발췌 개수 상한(5개) + "더보기" 버튼 (2026-08-14, [제안] —
   DESIGN에 명세 없음). #ResultCardCopyButton과 같은 톤으로 맞춘다.
   챗봇도 검색과 같은 버튼을 쓴다(처음엔 텍스트 안내만이었다가, 사용자
   요청으로 검색과 동일한 "더보기" 버튼으로 통일했다). */
#ResultListMoreButton {
    border: none;
    background: transparent;
    color: #2563EB;
    font-size: 13px;
    padding: 6px;
}

#ResultListMoreButton:hover {
    text-decoration: underline;
}

/* ---------- 공용 입력창 (Phase 7.7) ----------
   검색 결과 모드·챗봇 모드가 함께 쓴다. 옛 #ChatInput/#ChatSendButton(챗봇
   전용 시절)과 #SearchInput(검색 전용 시절)을 이 규칙으로 통합했다. */
#InputBar {
    background: #FFFFFF;
    border-top: 1px solid #E5E7EB;
}

#InputBarField {
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    color: #1F2937;
    background: #FFFFFF;
}

#InputBarField:focus {
    border-color: #2563EB;
}

#InputBarSendButton {
    background: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 14px;
}

#InputBarSendButton:hover {
    background: #1D4ED8;
}

/* 표 카드 (§5.4) */
#TableCardGrid {
    border: 1px solid #E5E7EB;
    gridline-color: #E5E7EB;
    font-size: 13px;
    color: #1F2937;
    background: #FFFFFF;
}

#TableCardGrid QHeaderView::section {
    background: #F1F2F4;
    color: #1F2937;
    font-weight: 700;
    font-size: 12px;
    border: 1px solid #E5E7EB;
    padding: 4px 6px;
}

/* 이미지 카드 (§5.5) */
#ImageCardThumbnail {
    border: 1px solid #E5E7EB;
    border-radius: 4px;
    background: #F7F8F9;
}

#ImageCardNotice {
    color: #9CA3AF;
    font-size: 13px;
}

/* ---------- 상태바 (§6) ---------- */

#StatusBar {
    background: #FFFFFF;
    border-top: 1px solid #E5E7EB;
}

#StatusBarInfo {
    color: #9CA3AF;
    font-size: 12px;
}

/* Phase 11-E — 나머지 두 팝업(폴더 관리·모델 관리)과 눈높이를 맞춘다.
   지금까지 이 다이얼로그는 배경·여백 지정이 전혀 없어 기본 Qt 여백으로
   붙어 보였다. */
#IndexingProgressDialog {
    background: #FFFFFF;
}

#IndexingProgressInfo {
    color: #1F2937;
    font-size: 14px;
    font-weight: 700;
}

#IndexingProgressStage {
    color: #9CA3AF;
    font-size: 12px;
}

#IndexingProgressFile {
    color: #9CA3AF;
    font-size: 12px;
}

#IndexingProgressTime {
    color: #9CA3AF;
    font-size: 12px;
}

#StatusBarWarning {
    /* DESIGN에 경고색 지정이 없어 자체 판단[제안] — amber 계열 */
    color: #B45309;
    font-size: 12px;
}

/* ---------- 폴더 관리 팝업 (Phase 11-E) ---------- */

/* 문서 관리 카드와 같은 눈높이로 맞춘다 — 새 색을 만들지 않고 PageEyebrow·
   PrimaryButton·SidebarFooterButton 토큰을 그대로 재사용한다. */
#FolderDialog {
    background: #FFFFFF;
}

#FolderDialogPath {
    color: #1F2937;
    font-size: 13px;
}

#FolderDialogDivider {
    background: #E5E7EB;
}

/* ---------- 모델 관리 팝업 (Phase 11-E 재도색) ---------- */

/* 폴더 관리 팝업과 같은 원칙 — 새 색을 만들지 않고 기존 카드·배지·버튼
   토큰을 재사용한다. */
#ModelManagerDialog {
    background: #FFFFFF;
}

#ModelManagerIntro, #ModelManagerPlaceholder {
    color: #9CA3AF;
    font-size: 12px;
}

#ModelManagerDivider {
    background: #E5E7EB;
}

/* 행 하나 = 카드 하나. 지금까지는 배경·경계가 없어 목록이 표처럼 붙어
   보였다 — 문서 관리 페이지의 통계 칸(StatCell)과 같은 톤으로 분리한다. */
#ModelRow {
    background: #F8FAFC;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
}

#ModelRowName {
    color: #1F2937;
    font-size: 14px;
    font-weight: 700;
}

/* 배지를 알약(pill) 모양으로 — 문서 관리 페이지의 PageBadge와 같은 형태
   (배경+패딩+둥근 모서리)로 맞추고, 색상 자체는 기존 3색을 그대로 쓴다. */
#ModelRowBadge {
    border-radius: 10px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 700;
}

#ModelRowBadge[state="installed"] {
    background: #DCFCE7;
    color: #15803D;
}

#ModelRowBadge[state="pending"] {
    background: #EEF2F7;
    color: #52606D;
}

/* 파일은 있으나 크기·체크섬이 안 맞는다 (T7.9) */
#ModelRowBadge[state="invalid"] {
    background: #FEE2E2;
    color: #B91C1C;
}

#ModelRowNote {
    color: #9CA3AF;
    font-size: 11px;
}
