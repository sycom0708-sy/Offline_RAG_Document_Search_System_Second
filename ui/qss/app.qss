/* DESIGN §10 디자인 토큰을 그대로 옮긴다.
   Qt Style Sheets는 CSS 변수를 지원하지 않아 값을 그대로 반복 기입한다.

   페이지 배경 #F7F8F9 · 패널/카드 #FFFFFF · 테두리 #E5E7EB
   본문 텍스트 #1F2937 · 보조 텍스트 #9CA3AF · 강조 #2563EB
   검색어 하이라이트 #FDE68A(ui/highlight.py에서 인라인으로 직접 적용)
*/

QMainWindow, #CentralWidget {
    background: #F7F8F9;
}

/* ---------- 검색바 (§3.1) ---------- */

#SearchBar {
    background: #FFFFFF;
    border-bottom: 1px solid #E5E7EB;
}

#SearchIcon {
    color: #9CA3AF;
    font-size: 14px;
}

#SearchInput {
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    color: #1F2937;
    background: #FFFFFF;
    margin: 8px 0;
}

#SearchInput:focus {
    border-color: #2563EB;
}

/* ---------- 사이드바 (§4) ---------- */

#Sidebar {
    background: #FFFFFF;
    border-right: 1px solid #E5E7EB;
}

#SidebarSectionLabel {
    color: #9CA3AF;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.02em;
}

/* 문서 형식 체크박스 — 사각 체크, 파란색 채움 (§4.1) */
QCheckBox {
    color: #1F2937;
    font-size: 14px;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #E5E7EB;
    border-radius: 4px;
    background: #FFFFFF;
}

QCheckBox::indicator:checked {
    background: #2563EB;
    border-color: #2563EB;
}

/* 토글 스위치 (§4.2) — QCheckBox를 알약 모양으로 재스타일링.
   손잡이가 슬라이드하는 애니메이션은 커스텀 페인팅이 필요해 이번 Phase는
   단색 채움으로 on/off를 구분하는 단순화된 형태로 둔다. */
QCheckBox[variant="switch"]::indicator {
    width: 36px;
    height: 20px;
    border-radius: 10px;
    border: 1px solid #E5E7EB;
    background: #E5E7EB;
}

QCheckBox[variant="switch"]::indicator:checked {
    background: #2563EB;
    border-color: #2563EB;
}

QCheckBox[variant="switch"]:disabled {
    color: #9CA3AF;
}

QCheckBox[variant="switch"]:disabled::indicator {
    background: #F7F8F9;
    border-color: #E5E7EB;
}

/* PC 성능 콤보 (§4.3) */
#PerformanceCombo {
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 14px;
    color: #1F2937;
    background: #FFFFFF;
}

/* ---------- 결과 리스트 / 카드 (§5) ---------- */

#ResultList {
    background: #F7F8F9;
    border: none;
}

#ResultListMessage {
    color: #9CA3AF;
    font-size: 14px;
    padding: 48px 24px;
}

#ResultCard {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
}

#ResultCard[relevance="low"] {
    border-color: #F1F2F4;
}

#ResultCardFileName {
    color: #1F2937;
    font-size: 14px;
    font-weight: 700;
}

#ResultCardSeparator, #ResultCardLocation {
    color: #9CA3AF;
    font-size: 12px;
}

#ResultCardRelevanceLabel {
    color: #9CA3AF;
    font-size: 12px;
}

#ResultCardBody {
    color: #1F2937;
    font-size: 14px;
}

#ResultCardOpenButton {
    border: none;
    background: transparent;
    color: #2563EB;
    font-size: 12px;
    padding: 2px 4px;
}

#ResultCardOpenButton:hover {
    text-decoration: underline;
}

/* ---------- 상태바 (§6) ---------- */

#StatusBar {
    background: #FFFFFF;
    border-top: 1px solid #E5E7EB;
}

#StatusBarInfo {
    color: #9CA3AF;
    font-size: 12px;
}

#StatusBarFolderButton {
    border: none;
    background: transparent;
    color: #2563EB;
    font-size: 12px;
}

#StatusBarFolderButton:hover {
    text-decoration: underline;
}

/* ---------- 모델 관리 팝업 ---------- */

#ModelManagerIntro, #ModelManagerPlaceholder {
    color: #9CA3AF;
    font-size: 12px;
}

#ModelRowName {
    color: #1F2937;
    font-size: 14px;
    font-weight: 700;
}

#ModelRowBadge[state="installed"] {
    color: #15803D;
    font-size: 11px;
    font-weight: 700;
}

#ModelRowBadge[state="pending"] {
    color: #52606D;
    font-size: 11px;
    font-weight: 700;
}

#ModelRowNote {
    color: #9CA3AF;
    font-size: 11px;
}
