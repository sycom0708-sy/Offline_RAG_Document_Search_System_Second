__pycache__/
*.pyc

# Claude Code 로컬 설정 (머신별)
.claude/settings.local.json
.venv/
venv/
# KURE-v1 변환 전용 임시 venv (Phase 7.5) — torch/optimum이 들어가므로 런타임
# venv와 격리한다. 변환이 끝나면 통째로 지운다.
.venv-convert/
# 변환 중간 산출물 (fp32 ONNX, --clean 없이 실행하면 남는다. 최대 2.3GB)
build/
# PyInstaller 빌드 결과물 (T9.1) — 수 GB, `python -m deploy.build`로 다시 만들 수 있다.
dist/
deploy/output/
*.egg-info/
.pytest_cache/
tests/samples/generated/
.assets/

# 임베딩 모델·sLM(GGUF) — 용량이 커서 저장소에 넣지 않는다.
# `python -m indexer.vector.download` / `python -m slm.download`로 받거나,
# 오프라인 PC에는 폴더째 복사한다.
models/

# 번들 바이너리 (LibreOffice 포터블, llama.cpp) — 용량이 크고 플랫폼 종속적이다.
# `python -m scripts.setup_llamacpp`로 받는다.
vendor/

# 앱 실행 시 생성되는 인덱스 DB·상태 파일 (개인 대상 폴더에 종속적)
data/

# 검증용 실문서는 저장소에 포함하지 않는다 (테스트가 루트에서 자동 탐색)
*.hwp
*.db
*.sqlite3
.chroma/

# 앱·도구 실행 로그 (app_stdout.log, app_stderr.log 등) — 실행할 때마다 생기는
# 흔적이라 저장소에 넣지 않는다.
*.log

# 개인 작업용 메모 (녹화 시나리오 등) — 저장소 공유 대상 아님
